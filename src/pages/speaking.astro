// Badge order and colours. A talk's "type" is a comma-separated list of these
// names, matched exactly, so the badges and the type filter always agree.
const badges = [
  { type: 'Talk',           class: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300' },
  { type: 'Tutorial',       class: 'bg-orange-300 text-black dark:bg-orange-700 dark:text-orange-100' },
  { type: 'Keynote',        class: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-100' },
  { type: 'Meetup',         class: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' },
  { type: 'Video',          class: 'bg-red-600 text-white dark:bg-red-700 dark:text-red-100' },
  { type: 'Audio',          class: 'bg-green-700 text-white dark:bg-green-700 dark:text-green-100' },
  { type: 'Webinar',        class: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-300' },
  { type: 'Thesis',         class: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300' },
  { type: 'Podcast',        class: 'bg-pink-100 text-pink-800 dark:bg-pink-900 dark:text-pink-100' },
  { type: 'Panel',          class: 'bg-yellow-200 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300' },
  { type: 'Lightning Talk', class: 'bg-yellow-500 text-black dark:bg-yellow-600 dark:text-black' },
  { type: 'Upcoming',       class: 'bg-yellow-500 text-red-800 dark:bg-yellow-300 dark:text-black', label: 'Upcoming ★' },
]
const badgeClass = 'text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm'
const videoBadge = badges.find((b) => b.type === 'Video')!

const typesOf = (talk: { type: string }) => talk.type.split(',').map((t) => t.trim())
const yearOf = (talk: { date: string }) => talk.date.match(/\d{4}/)?.[0] ?? ''
const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
// "May 2026" -> "2026-05", for <time datetime>
const isoMonthOf = (talk: { date: string }) => {
  const [month, year] = talk.date.split(' ')
  return `${year}-${String(months.indexOf(month) + 1).padStart(2, '0')}`
}
const years = [...new Set(talks.map(yearOf))].filter(Boolean).sort().reverse()

---

<Layout>
  <PageHead slot="head" title="Speaking" />
  <Breadcrumbs items={[{ label: 'Speaking', icon: 'lucide:info' }]} />

  <section>
    <div class="min-w-full">
      <h1 class="text-3xl mb-5">Speaking</h1>
      <p class="mb-5">
      Here you can find a list of all the talks, podcasts, and panels in which I have had the opportunity to speak
      publicly. Most of these talks have been held at Python and tech events in different countries around
      the world, and also at online events.
      </p>
      <p class="mb-5">
      Some talks weren't recorded, but for most of them you can find the recording by looking for
      the <span class:list={[badgeClass, videoBadge.class]}>Video</span>
      badge to watch the recording.
      </p>
      <div class="mb-5 flex flex-wrap items-center gap-3 text-sm border-2 p-4">
        <label class="flex items-center gap-2">
          Filter events by Type
          <select id="talk-type-filter" class="rounded-sm border border-gray-300 bg-transparent px-2 py-1 dark:border-gray-600 dark:bg-gray-900">
            <option value="">All</option>
            {badges.map((b) => <option value={b.type}>{b.type}</option>)}
          </select>
        </label>
        <label class="flex items-center gap-2">
          Year
          <select id="talk-year-filter" class="rounded-sm border border-gray-300 bg-transparent px-2 py-1 dark:border-gray-600 dark:bg-gray-900">
            <option value="">All</option>
            {years.map((y) => <option value={y}>{y}</option>)}
          </select>
        </label>
        <span id="talk-count" class="text-gray-600 dark:text-gray-300" aria-live="polite"></span>
      </div>
      <ol id="talk-list" class="relative border-s border-gray-200 dark:border-gray-700">

        {talks.map((talk) => (
        <li class="mb-5 ms-4" data-types={typesOf(talk).join('|')} data-year={yearOf(talk)}>
          <div class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700"></div>
          <time datetime={isoMonthOf(talk)} class="mb-1 text-sm font-normal leading-none text-gray-600 dark:text-gray-300">{ talk.date }</time>
          {talk.url
            ? <a target="_blank" rel="noopener noreferrer" href={ talk.url }><h3 class="text-xl font-semibold text-gray-900 dark:text-white">{ talk.title }</h3></a>
            : <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{ talk.title }</h3>}
          {badges.filter((b) => typesOf(talk).includes(b.type)).map((b) => (
            <span class:list={[badgeClass, b.class]}>{b.label ?? b.type}</span>
          ))}
          <p class="mt-2 text-base font-normal text-gray-800 dark:text-gray-200">
          { talk.event } @ { talk.location }
          </p>
        </li>
        ))}

      </ol>
    </div>
  </section>
</Layout>

<script>
  function setupTalkFilters() {
    const typeSelect = document.getElementById('talk-type-filter') as HTMLSelectElement | null
    const yearSelect = document.getElementById('talk-year-filter') as HTMLSelectElement | null
    const count = document.getElementById('talk-count')
    if (!typeSelect || !yearSelect) return

    const items = document.querySelectorAll<HTMLLIElement>('#talk-list > li')

    const apply = () => {
      const type = typeSelect.value
      const year = yearSelect.value
      let visible = 0
      items.forEach((li) => {
        const show =
          (!type || li.dataset.types!.split('|').includes(type)) &&
          (!year || li.dataset.year === year)
        li.hidden = !show
        if (show) visible++
      })
      if (count) count.textContent = `${visible} of ${items.length}`
    }

    typeSelect.addEventListener('change', apply)
    yearSelect.addEventListener('change', apply)
    apply()
  }

  document.addEventListener('astro:page-load', setupTalkFilters)
</script>
